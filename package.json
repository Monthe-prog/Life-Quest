{
  "name": "operator",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w @operator/frontend",
    "build": "npm run build -w @operator/frontend",
    "start": "npm run start -w @operator/frontend",
    "lint": "npm run lint -w @operator/frontend",
    "typecheck": "npm run typecheck -w @operator/frontend",
    "test": "npm run test:backend",
    "test:backend": "npm run test:backend:docker",
    "test:backend:docker": "docker compose build backend && docker compose run --rm --no-deps -v \"$PWD/apps/backend/test-results:/app/apps/backend/test-results\" backend python -m pytest",
    "test:backend:local": "cd apps/backend && python -m pytest",
    "coverage:backend": "npm run test:backend:docker"
  }
}
